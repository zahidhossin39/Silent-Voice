{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Silent Voice",
        "width": 980,
        "height": 700,
        "minWidth": 820,
        "minHeight": 560,
        "resizable": true,
        "visible": true,
        "center": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ]
  },
  "bundle": {
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/128x128@2x.png",
      "icons/128x128.png",
      "icons/32x32.png"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "resources": {
      "sidecars/*.dylib": "./",
      "sidecars/whisper-server": "./",
      "sidecars/llama/": "llama/",
      "sidecars/piper/": "piper/",
      "sidecars/sherpa/": "sherpa/"
    },
    "createUpdaterArtifacts": false
  }
}
