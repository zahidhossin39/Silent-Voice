<?xml version="1.0" encoding="utf-8"?>
<!-- Only window changes and focus changes are requested: enough to know when
     the keyboard is up. No text-changed or click events are delivered to us. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowsChanged|typeWindowStateChanged|typeViewFocused"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:description="@string/bubble_desc"
    android:notificationTimeout="100" />
